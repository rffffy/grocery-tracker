{
  "name": "receipt-backfill",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -400,
        96
      ],
      "id": "1d8d088c-8578-4be1-ac1e-28538c31b2b8",
      "name": "Manual Trigger"
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "searchMethod": "query",
        "queryString": "='<DRIVE_INBOX_FOLDER_ID>' in parents and mimeType != 'application/vnd.google-apps.folder'",
        "returnAll": true,
        "filter": {},
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -192,
        96
      ],
      "id": "070202ee-d50b-4c97-ae75-e9ecb089f326",
      "name": "List Inbox Files",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "<GOOGLE_DRIVE_CREDENTIAL_ID>",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "executeOnce": false,
        "command": "=sh -c \"uv run --directory /home/node/project receipt-loader < {{ $json.tmpPath }} && rm {{ $json.tmpPath }}\""
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        416,
        96
      ],
      "id": "85c8fb7c-dfc8-4648-94f2-2c395235855f",
      "name": "Run receipt-loader"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const stdout = $input.item.json.stdout.trim();\nreturn { json: JSON.parse(stdout) };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        96
      ],
      "id": "24d88ae0-381a-43aa-bb07-66244c7c98fe",
      "name": "Parse Output"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cc6c6a27-827b-4045-9c2a-1d90019aaadb",
              "leftValue": "={{ $json.new_aliases.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        832,
        96
      ],
      "id": "efca3279-1bcb-4a33-8835-1784ec26d56c",
      "name": "New Aliases?"
    },
    {
      "parameters": {
        "chatId": "<TELEGRAM_CHAT_ID>",
        "text": "=🟢 🧾 <b>New Aliases</b> 🧾\n\n<b>Receipt ID:</b> {{ $('Parse Output').item.json.receipt_id }}\n\nUpdate them in the Database (product aliases table):\n\n{{ $json.new_aliases.map(a => '• ID ' + a.alias_id + ' · ' + a.store + ' · ' + a.raw_name.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + (a.category_id === 12 ? ' · ⚠️  Uncategorized' : '')).join('\\n') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1056,
        -64
      ],
      "id": "9da49796-22e6-49d5-9706-c58d71f63642",
      "name": "Notify New Aliases",
      "credentials": {
        "telegramApi": {
          "id": "<TELEGRAM_CREDENTIAL_ID>",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "operation": "move",
        "fileId": {
          "__rl": true,
          "value": "={{ $('List Inbox Files').item.json.id }}",
          "mode": "id"
        },
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "<DRIVE_PROCESSED_FOLDER_ID>",
          "mode": "id"
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1296,
        96
      ],
      "id": "e183f451-5863-47b6-912e-6712f8f2c4ea",
      "name": "Move To Processed",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "<GOOGLE_DRIVE_CREDENTIAL_ID>",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        0,
        96
      ],
      "id": "9a2b5933-faa5-42a2-b6d7-3a97ebf97c38",
      "name": "Download File",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "<GOOGLE_DRIVE_CREDENTIAL_ID>",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const { writeFileSync } = require('fs');\n  const items = $input.all();\n  const result = [];\n  for (let i = 0; i < items.length; i++) {\n    const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n    const tmpPath = `/tmp/receipt-${Date.now()}-${i}.json`;\n    writeFileSync(tmpPath, buffer);\n    result.push({ json: { tmpPath } });\n  }\n  return result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        96
      ],
      "id": "b555211e-2bd8-4678-9628-70d791ce3be9",
      "name": "Write To Temp File"
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "List Inbox Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Inbox Files": {
      "main": [
        [
          {
            "node": "Download File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run receipt-loader": {
      "main": [
        [
          {
            "node": "Parse Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Output": {
      "main": [
        [
          {
            "node": "New Aliases?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "New Aliases?": {
      "main": [
        [
          {
            "node": "Notify New Aliases",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Move To Processed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify New Aliases": {
      "main": [
        [
          {
            "node": "Move To Processed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download File": {
      "main": [
        [
          {
            "node": "Write To Temp File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write To Temp File": {
      "main": [
        [
          {
            "node": "Run receipt-loader",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  }
}
