# ============================================================
# Grocery Tracker — environment variable template
# Copy this file to .env and fill in your values.
# This file is safe to commit — it contains no real secrets.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Read by receipt-loader (passed into the n8n container by docker-compose)
SUPABASE_DB_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:6543/postgres
# Used by the Supabase CLI: supabase link --project-ref $SUPABASE_PROJECT_REF
SUPABASE_PROJECT_REF=your-project-ref-here

# ── Values you paste into n8n credentials (reference only) ───
# Telegram bot token from @BotFather, and your chat ID with the bot
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKlmnoPQRsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Google Cloud OAuth client for the n8n Google Drive credential
GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
